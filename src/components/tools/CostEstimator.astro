    transition: color var(--t-fast, 0.18s), border-color var(--t-fast, 0.18s);
  }
  .cest__cta-soft:hover { color: var(--lime-bright, #a884ff); border-color: var(--lime-line, rgba(139, 92, 255, 0.46)); }
  .cest__cta-soft:focus-visible { outline: none; color: var(--lime-bright, #a884ff); border-color: var(--lime, #8b5cff); }

  /* ---- responsive ---- */
  @media (max-width: 760px) {
