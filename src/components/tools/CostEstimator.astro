    .cest__go:hover,
    .cest__cta-btn:hover { transform: none; }
  }
</style>

<script>
  // Progressive enhancement only. The page is fully readable and meaningful without
  // this: the price table, the default estimate, the breakdown, the ongoing line, the
  // caveat and the CTA are all in the static HTML. Here we recompute a personalised
  // range from the live selections and swap the text inside nodes that already exist.
  // Nothing is sent anywhere: no fetch, no analytics, no storage.
  //
  // Multi-instance safe + idempotent: every .cest on the page is bound once (keyed by
  // a WeakSet), and we re-scan on astro:page-load so client-side view-transition swaps
  // re-bind cleanly without double-binding.
  (function () {
    var bound = new WeakSet();

    // Deterministic comma grouping (R15,000), identical to the server formatter, so the
    // recomputed figure always matches the static default and the published table.
    var randZAR = function (n) {
      return 'R' + String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    };

    var TYPE_NOUN = {
      brochure: 'a brochure site',
      business: 'a business site built to convert',
      store: 'an online store',
      app: 'a web app or custom build',
    };
    var BUILDER_NOUN = {
      diy: 'a DIY builder',
      freelancer: 'a freelancer',
      agency: 'an agency',
      studio: 'a studio or engineer',
    };

    function initOne(root) {
      if (bound.has(root)) return;
      bound.add(root);

      var form = root.querySelector('#cest-form');
      var typeEl = root.querySelector('#cest-type');
      var builderEl = root.querySelector('#cest-builder');
      var live = root.querySelector('#cest-live');

      var rangeEl = root.querySelector('#cest-range');
      var modeEl = root.querySelector('#cest-range-mode');
      var breakdownEl = root.querySelector('#cest-breakdown');
      var caveatEl = root.querySelector('#cest-caveat');
      var ongoingFootEl = root.querySelector('#cest-ongoing-foot');

      if (!form || !typeEl || !builderEl || !rangeEl) return;

      // Single source of truth: read the same band matrix + feature table the static
      // HTML was rendered from, off the data attribute. No second copy to drift.
      var model;
      try {
        model = JSON.parse(root.getAttribute('data-model') || '{}');
      } catch (_) {
        return; // if the model can't be parsed, leave the honest static default in place
      }
      var bands = model.bands || {};
      var features = model.features || [];
      var featureById = {};
      features.forEach(function (f) {
        featureById[f.value] = f;
      });

      function selectedFeatures() {
        var out = [];
        var boxes = root.querySelectorAll('input[name="feature"]:checked');
        Array.prototype.forEach.call(boxes, function (b) {
          if (featureById[b.value]) out.push(featureById[b.value]);
        });
        return out;
      }

      function compute() {
        var type = typeEl.value;
        var builder = builderEl.value;
        var byBuilder = bands[builder] || {};
        var base = byBuilder[type];
        if (!base) return null;

        var lo = base.lo;
        var hi = base.hi;
        var monthly = base.mode === 'monthly';

        // Features widen the range honestly. We never add a feature that the base scope
        // already includes (implies), and for DIY the cost is mostly the owner's time,
        // so feature rand-deltas are suppressed and surfaced as a note instead.
        var added = [];
        var skippedImplied = [];
        selectedFeatures().forEach(function (f) {
          var implies = f.implies || [];
          if (implies.indexOf(type) !== -1) {
            skippedImplied.push(f.label);
            return;
          }
          added.push(f.label);
          if (!monthly) {
            lo += f.lo;
            hi += f.hi;
          }
        });

        return {
          type: type,
          builder: builder,
          lo: lo,
          hi: hi,
          monthly: monthly,
          added: added,
          skippedImplied: skippedImplied,
        };
      }

      function rangeText(r) {
        if (r.monthly) {
          // DIY: a monthly platform cost, with effectively no build fee.
          var loM = randZAR(r.lo);
          var hiM = randZAR(r.hi);
          return (r.lo <= 0 ? 'R0' : loM) + ' to ' + hiM + ' / month';
        }
        return randZAR(r.lo) + ' to ' + randZAR(r.hi);
      }

      function render() {
        var r = compute();
        if (!r) return;

        rangeEl.textContent = rangeText(r);

        // Mode line under the headline range.
        if (modeEl) {
          modeEl.textContent = r.monthly
            ? 'monthly platform cost, little or no build fee'
            : 'once-off build, before ongoing costs';
        }

        // Breakdown sentence, assembled from the live selection. Honest and specific.
        if (breakdownEl) {
          var parts = [];
          parts.push(
            'This is the typical 2026 range for ' +
              (TYPE_NOUN[r.type] || 'your site') +
              ' built by ' +
              (BUILDER_NOUN[r.builder] || 'your chosen route') +
              (r.added.length ? '' : ', with no extra features added yet') +
              '.'
          );
          if (r.added.length) {
            parts.push(
              (r.monthly
                ? 'On a DIY builder, ' +
                  r.added.join(', ') +
                  ' is mostly set-up time rather than rand, so the platform price barely moves; the cost is your hours.'
                : r.added.join(', ') +
                  ' each add real build time, which is why the range widens. We keep it a range, not a single number, because the honest figure depends on scope.')
            );
          } else {
            parts.push(
              'Tick the features you need above and the range updates: each one adds real build time, so it widens the figure honestly rather than pretending to a single precise number.'
            );
          }
          if (r.skippedImplied.length) {
            parts.push(
              r.skippedImplied.join(' and ') +
                ' is already part of an online store, so we did not add it twice.'
            );
          }
          breakdownEl.textContent = parts.join(' ');
        }

        // Ongoing-costs footnote reflects DIY vs build.
        if (ongoingFootEl) {
          ongoingFootEl.textContent = r.monthly
            ? 'On a DIY builder, hosting and SSL are inside the monthly fee above; the domain is the one separate yearly line, and you can register it in your own name.'
            : 'A builder rolls hosting into its monthly fee. SSL is normally free. Skip a maintenance retainer for a site that never changes.';
        }

        // Caveat stays honest and constant in spirit; we keep it explicit.
        if (caveatEl) {
          caveatEl.textContent =
            'Indicative 2026 market ranges. A real quote depends on your exact scope, content, and who builds it. Price the two-year total, not just the build fee.';
        }

        return r;
      }

      // Submit: recompute, announce, and bring the (already-visible) result into view.
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var r = render();
        if (!r) return;
        if (live) {
          live.textContent = 'Estimate updated: ' + rangeText(r) + '. This is an indicative range, not a fixed quote.';
        }
        var result = root.querySelector('#cest-result');
        if (result && typeof result.scrollIntoView === 'function') {
          var reduce =
            window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          result.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
        }
      });

      // Live recompute as selections change (cheap, local-only). The result panel is
      // already in view above the fold of the result, so we update silently here and
      // reserve the aria-live announcement + scroll for the explicit submit.
      typeEl.addEventListener('change', render);
      builderEl.addEventListener('change', render);
      Array.prototype.forEach.call(
        root.querySelectorAll('input[name="feature"]'),
        function (box) {
          box.addEventListener('change', render);
        }
      );

      // Compute once on load so the panel reflects any browser-restored form state
      // (e.g. after a back-navigation) rather than the hard-coded static default.
      render();
    }

    function run() {
      var nodes = document.querySelectorAll('.cest');
      Array.prototype.forEach.call(nodes, initOne);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true });
    } else {
      run();
    }
    // Astro View Transitions: re-scan after client-side swaps.
    document.addEventListener('astro:page-load', run);
  })();
</script>
