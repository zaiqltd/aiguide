  }
  .cest__cta-btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--lime-wash, rgba(139, 92, 255, 0.3)), var(--glow-lime, 0 0 40px -8px rgba(139, 92, 255, 0.62));
  }
  .cest__cta-soft {
    font-size: 0.9rem;
    color: var(--silver, #cdcac3);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2, rgba(243, 240, 233, 0.16));
