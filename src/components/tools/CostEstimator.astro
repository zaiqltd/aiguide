  }
  .cest__cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.3rem; }
  .cest__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--lime-ink, #fff);
    background: var(--lime, #8b5cff);
    border-radius: var(--radius, 6px);
    padding: 0.9rem 1.35rem;
