    letter-spacing: -0.015em;
    color: var(--bone, #f4f1ea);
    margin: 0;
    text-wrap: balance;
  }
  .cest__range-mode {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ash, #908d86);
    margin: 0.45rem 0 0;
  }
  .cest__breakdown {
    color: var(--silver, #cdcac3);
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 1.05rem 0 0;
