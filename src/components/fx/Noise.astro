---
/**
 * Noise.astro — fixed film-grain overlay across the whole canvas.
 *
 * Ported from the Magic UI noise-texture (feTurbulence) technique. Instead of a
 * live <svg> filter we bake a single fractal-noise tile into a data-URI and tile
 * it as a background — cheaper to paint and trivially static. Sits fixed over
 * everything at a whisper opacity with `mix-blend-mode: overlay`, so it adds
 * tooth to the black without lifting blacks or tinting color.
 *
 * Decorative only; never intercepts input.
 */
interface Props {
  /** Grain strength. Keep it nearly subliminal on near-black. Default 0.04. */
  opacity?: number;
}
const { opacity = 0.04 } = Astro.props;

// Inline fractalNoise tile. baseFrequency 0.8 + 4 octaves = fine, even film grain.
// URL-encoded so it is valid inside a CSS url("data:image/svg+xml,...").
const noiseSvg = encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="4" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="100%" height="100%" filter="url(#n)"/></svg>`
);
---

<div
  class="noise"
  aria-hidden="true"
  style={`--noise-opacity:${opacity};--noise-url:url("data:image/svg+xml,${noiseSvg}")`}
>
</div>

<style>
  .noise {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: var(--noise-opacity, 0.04);
    background-image: var(--noise-url);
    background-repeat: repeat;
    background-size: 120px 120px;
    /* Overlay lets the grain darken/lighten texture without recoloring. */
    mix-blend-mode: overlay;
  }

  /* Static by design — nothing to disable for reduced motion, and the grain is
     intentionally still (no shimmer), so it stays accessible as-is. */
</style>
