---
// Top byline: avatar + named author linked to their entity page + dates. The authority signal.
interface Props {
  authorId: string;
  name: string;
  short: string;
  datePublished: string;
  dateModified?: string;
}
const { authorId, name, short, datePublished, dateModified } = Astro.props;
const initials = name.split(' ').map((x) => x[0]).join('');
const tone = authorId.includes('chad') ? 'chad' : 'adam';
const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-ZA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const updated = dateModified && dateModified !== datePublished;
---
<div class="byline">
  <a class={`avatar avatar--sm avatar--${tone}`} href={`/authors/${authorId}`} aria-hidden="true" tabindex="-1">{initials}</a>
  <div class="byline__who">
    <span class="byline__line">
      <span class="byline__by mono">Written by</span>
      <a class="byline__name" href={`/authors/${authorId}`} rel="author">{name}</a>
    </span>
    <span class="byline__short">{short}</span>
  </div>
  <p class="byline__dates mono">
    <time datetime={datePublished}>{fmt(datePublished)}</time>
    {updated && <span> &middot; updated <time datetime={dateModified}>{fmt(dateModified!)}</time></span>}
  </p>
</div>

<style>
  .byline { display: flex; align-items: center; gap: 0.85rem; padding: 0.9rem 0; border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); margin: 1.6rem 0 0; max-width: var(--measure-wide); }
  .byline__who { flex: 1; min-width: 0; }
  .byline__line { display: flex; align-items: baseline; gap: 0.45rem; flex-wrap: wrap; }
  .byline__by { color: var(--graphite-soft); }
  .byline__name { font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); text-decoration: none; }
  .byline__name:hover { color: var(--oxblood); text-decoration: underline; }
  .byline__short { display: block; color: var(--graphite); font-size: 0.9rem; margin-top: 0.1rem; }
  .byline__dates { color: var(--graphite-soft); margin: 0; font-size: 0.64rem; text-align: right; flex-shrink: 0; }
  @media (max-width: 560px) { .byline__dates { display: none; } }
</style>
